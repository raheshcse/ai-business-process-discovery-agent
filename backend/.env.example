APP_NAME=AI Business Process Discovery Agent
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./business_process_discovery.db
CORS_ORIGINS=http://localhost:5173

# Ollama is the default local provider. OPENAI_API_KEY is only required when
# LLM_PROVIDER=openai.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# A 3B model on CPU needs minutes per stage, not seconds.
OLLAMA_TIMEOUT_SECONDS=300
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=2000

# --- RAG indexing and retrieval ------------------------------------
# `ollama` is the default and the only provider with semantic scores.
# `local` hashes text: its cosine scores are effectively random and often
# negative, which causes the evidence governance gate to block runs for
# reasons unrelated to your documents. Use `local` for tests only.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LOCAL_EMBEDDING_DIMENSION=128
# Texts per embedding request. A large document produces hundreds of chunks;
# sending them all at once makes Ollama run that many forward passes before
# replying, which times out on CPU. Lower this if indexing large files times
# out; raise it on a GPU for speed.
EMBEDDING_BATCH_SIZE=16
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=120
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CONTEXT_CHARACTERS=12000
RETRIEVAL_TOP_K=5

# --- Governance ----------------------------------------------------
GOVERNANCE_GAMMA_THRESHOLD=1.1
# Must be within [0.0, 1.0]; enforced by ProcessDiscoveryGovernanceConfig.
GOVERNANCE_MINIMUM_EVIDENCE_SCORE=0.35
GOVERNANCE_MINIMUM_PROCESS_FINDINGS=1
GOVERNANCE_LEDGER_PATH=governance_ledger.jsonl
GOVERNANCE_LEDGER_FSYNC=false
# Audit check 1 needs a domain-chosen cadence. Leave unset to skip it
# rather than invent a threshold.
# GOVERNANCE_MAX_MONITOR_GAP_SECONDS=300

# Uploads
UPLOADS_DIRECTORY=uploads
MAX_UPLOAD_SIZE_BYTES=26214400
